{
  "name": "matchoncard-api",
  "version": "1.0.0",
  "description": "API principal de MatchOnCard: validación en 3 pasos (huella, rostro y firma) y firma de documentos",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrar": "ts-node src/scripts/migrar.ts",
    "cliente:crear": "ts-node src/scripts/crear-cliente.ts",
    "admin:crear": "ts-node src/scripts/crear-admin.ts",
    "bucket:configurar": "ts-node src/scripts/configurar-bucket.ts",
    "kek:rotar": "ts-node src/scripts/rotar-kek.ts",
    "test:e2e": "ts-node src/scripts/prueba-e2e.ts",
    "test:documentos": "ts-node src/scripts/prueba-documentos.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/throttler": "^6.2.0",
    "adm-zip": "^0.5.18",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "16.4.7",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.2",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.6",
    "nodemon": "3.1.10",
    "ts-node": "10.9.2",
    "typescript": "^5.5.0"
  }
