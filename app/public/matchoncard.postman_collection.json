                "exec": [
                  "if (pm.response.code < 300) {",
                  "  const r = pm.response.json();",
                  "  if (r.documento_id) pm.collectionVariables.set('documento_id', r.documento_id);",
                  "  if (r.firmantes && r.firmantes[0] && r.firmantes[0].firmante_id) pm.collectionVariables.set('firmante_id', r.firmantes && r.firmantes[0] && r.firmantes[0].firmante_id);",
                  "}"
                ]
